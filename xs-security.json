{
  "xsappname": "pp-backendServices-001",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Supplier",
      "description": "Access to supplier-restricted areas"
    },
    {
      "name": "$XSAPPNAME.Display",
      "description": "Public access"
    },
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Full administrative access"
    },
    {
      "name": "$XSAPPNAME.ProveedorProvisorio",
      "description": "Acceso para proveedores en proceso de registro"
    },
    {
      "name": "$XSAPPNAME.ProveedorActivo",
      "description": "Acceso completo para proveedores activos"
    },
    {
      "name": "$XSAPPNAME.ProveedorPrecertificacion",
      "description": "Acceso del proveedor a precertificacion (habilitado por invitacion en un momento especifico, independiente de provisorio/activo)"
    },
    {
      "name": "$XSAPPNAME.AprobadorLegales",
      "description": "Permite aprobar/rechazar solicitudes ABM - Legales"
    },
    {
      "name": "$XSAPPNAME.AprobadorImpuestos",
      "description": "Permite aprobar/rechazar solicitudes ABM - Impuestos (Tax)"
    },
    {
      "name": "$XSAPPNAME.AprobadorTesoreria",
      "description": "Permite aprobar/rechazar solicitudes ABM - Tesoreria"
    },
    {
      "name": "$XSAPPNAME.CoordinadorProveedores",
      "description": "Comprador Accesos-Desbloqueo: envio de credenciales, desbloqueo y modificacion de correo de contacto"
    },
    {
      "name": "$XSAPPNAME.Comprador",
      "description": "Visualizacion del catalogo ABM y de auditoria (solo lectura)"
    },
    {
      "name": "$XSAPPNAME.Visualizador",
      "description": "Visualizacion de la lista de proveedores (solo lectura)"
    },
    {
      "name": "$XSAPPNAME.CoordinadorACAPPrecertificacion",
      "description": "Coordinacion de precertificacion ACAP: otorgamiento de acceso y reenvio"
    },
    {
      "name": "$XSAPPNAME.FiscalizadorPrecertificacion",
      "description": "Fiscalizacion de procesos de precertificacion"
    },
    {
      "name": "$XSAPPNAME.Auditor",
      "description": "Solo lectura de todas las apps (ACAP, ABM, Auditoria, Gestor de Accesos)"
    },
    {
      "name": "$XSAPPNAME.ACAP",
      "description": "Auditor y editor de Tickets (solo asignados)"
    }
  ],
  "role-templates": [
    {
      "name": "SupplierUser",
      "description": "Access for suppliers",
      "scope-references": [
        "$XSAPPNAME.Supplier"
      ],
      "attribute-references": ["supplierID"]
    },
    {
      "name": "AdminUser",
      "description": "Full access for administrators",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "ProveedorProvisorio",
      "description": "Rol para proveedores nuevos (con bp_id)",
      "scope-references": [
        "$XSAPPNAME.ProveedorProvisorio"
      ],
      "attribute-references": [
        "bp_id"
      ]
    },
    {
      "name": "ProveedorActivo",
      "description": "Rol para proveedores validados (con bp_id)",
      "scope-references": [
        "$XSAPPNAME.ProveedorActivo"
      ],
      "attribute-references": [
        "bp_id"
      ]
    },
    {
      "name": "ProveedorPrecertificacion",
      "description": "Proveedor habilitado para precertificacion (con bp_id)",
      "scope-references": [
        "$XSAPPNAME.ProveedorPrecertificacion"
      ],
      "attribute-references": [
        "bp_id"
      ]
    },
    {
      "name": "PP_AprobadorLegales",
      "description": "Departamento legal",
      "scope-references": [
        "$XSAPPNAME.AprobadorLegales"
      ]
    },
    {
      "name": "PP_AprobadorImpuestos",
      "description": "Departamento de impuestos (Tax)",
      "scope-references": [
        "$XSAPPNAME.AprobadorImpuestos"
      ]
    },
    {
      "name": "PP_AprobadorTesoreria",
      "description": "Departamento de tesoreria",
      "scope-references": [
        "$XSAPPNAME.AprobadorTesoreria"
      ]
    },
    {
      "name": "PP_CoordinadorProveedores",
      "description": "Comprador Accesos-Desbloqueo (coordinador de proveedores)",
      "scope-references": [
        "$XSAPPNAME.CoordinadorProveedores"
      ]
    },
    {
      "name": "PP_Comprador",
      "description": "Comprador (visualizacion catalogo ABM + auditoria)",
      "scope-references": [
        "$XSAPPNAME.Comprador"
      ]
    },
    {
      "name": "PP_Visualizador",
      "description": "Visualizador (lista de proveedores)",
      "scope-references": [
        "$XSAPPNAME.Visualizador"
      ]
    },
    {
      "name": "PP_CoordinadorACAPPrecertificacion",
      "description": "Coordinador ACAP",
      "scope-references": [
        "$XSAPPNAME.CoordinadorACAPPrecertificacion"
      ]
    },
    {
      "name": "PP_FiscalizadorPrecertificacion",
      "description": "Fiscalizador",
      "scope-references": [
        "$XSAPPNAME.FiscalizadorPrecertificacion"
      ]
    },
    {
      "name": "PP_Admin",
      "description": "Administrador del sistema (FF + gestion de usuarios BTP-IAS)",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "PP_Auditor",
      "description": "Auditor (solo lectura global)",
      "scope-references": [
        "$XSAPPNAME.Auditor"
      ]
    },
    {
      "name": "PP_ACAP",
      "description": "Auditor y editor de Tickets (solo asignados)",
      "scope-references": [
        "$XSAPPNAME.ACAP"
      ]
    }
  ],
  "attributes": [
    {
      "name": "supplierID",
      "description": "Supplier ID assigned to the user",
      "valueType": "string"
    },
    {
      "name": "bp_id",
      "description": "ID del Business Partner del Proveedor desde IAS",
      "valueType": "string"
    }
  ],
  "role-collections": [
  {
    "name": "SupplierAccess",
    "description": "Access to supplier entities",
    "role-template-references": [
      "$XSAPPNAME.SupplierUser"
    ]
  },
  {
    "name": "AdminAccess",
    "description": "Full admin access",
    "role-template-references": [
      "$XSAPPNAME.AdminUser"
    ]
  },
  {
    "name": "PP_ProveedorProvisorio",
    "role-template-references": ["$XSAPPNAME.ProveedorProvisorio"]
  },
  {
    "name": "PP_ProveedorActivo",
    "role-template-references": ["$XSAPPNAME.ProveedorActivo"]
  },
  {
    "name": "PP_ProveedorPrecertificacion",
    "role-template-references": ["$XSAPPNAME.ProveedorPrecertificacion"]
  },
  {
    "name": "PP_AprobadorLegales",
    "role-template-references": ["$XSAPPNAME.PP_AprobadorLegales"]
  },
  {
    "name": "PP_AprobadorImpuestos",
    "role-template-references": ["$XSAPPNAME.PP_AprobadorImpuestos"]
  },
  {
    "name": "PP_AprobadorTesoreria",
    "role-template-references": ["$XSAPPNAME.PP_AprobadorTesoreria"]
  },
  {
    "name": "PP_CoordinadorProveedores",
    "role-template-references": ["$XSAPPNAME.PP_CoordinadorProveedores"]
  },
  {
    "name": "PP_Comprador",
    "role-template-references": ["$XSAPPNAME.PP_Comprador"]
  },
  {
    "name": "PP_Visualizador",
    "role-template-references": ["$XSAPPNAME.PP_Visualizador"]
  },
  {
    "name": "PP_CoordinadorACAPPrecertificacion",
    "role-template-references": ["$XSAPPNAME.PP_CoordinadorACAPPrecertificacion"]
  },
  {
    "name": "PP_FiscalizadorPrecertificacion",
    "role-template-references": ["$XSAPPNAME.PP_FiscalizadorPrecertificacion"]
  },
  {
    "name": "PP_Admin",
    "role-template-references": ["$XSAPPNAME.PP_Admin"]
  },
  {
    "name": "PP_Auditor",
    "role-template-references": ["$XSAPPNAME.PP_Auditor"]
  },
  {
    "name": "PP_ACAP",
    "role-template-references": ["$XSAPPNAME.PP_ACAP"]
  }
]

}
